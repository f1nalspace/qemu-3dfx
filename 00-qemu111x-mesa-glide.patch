+    if (!SDL_GetHint(SDL_HINT_RENDER_DRIVER) ||
+        memcmp(SDL_GetHint(SDL_HINT_RENDER_DRIVER), hint, sizeof(hint) - 1)) {
+        SDL_SetHint(SDL_HINT_RENDER_DRIVER, hint);
