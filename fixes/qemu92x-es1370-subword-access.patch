+/*
+ * The guest programs this chip byte- and word-wise, so accesses narrower than a
+ * register have to be merged here: the memory core does not align them down, it
+ * hands the device the unaligned address as is. Without this the switch above
+ * misses every such access -- writes vanish and reads return all ones.
+ */
+static void es1370_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    const unsigned int bits_per_byte = 8;
+    ES1370State *s = opaque;
+    uint32_t register_addr = es1370_fixup(s, addr);
+    unsigned int byte_offset = register_addr & 3;
+    uint32_t merged_value;
+
+    register_addr &= ~3U;
+
+    if (byte_offset == 0 && size == 4) {
+        merged_value = val;
+    } else {
+        unsigned int shift = byte_offset * bits_per_byte;
+        uint64_t size_mask = (1ULL << (size * bits_per_byte)) - 1;
+        uint32_t merge_mask = size_mask << shift;
+        uint32_t current_value = es1370_read_register(s, register_addr);
+
+        merged_value = (current_value & ~merge_mask) | ((val << shift) & merge_mask);
+        trace_es1370_subword_wr(register_addr, byte_offset, size, val, merged_value);
+    }
+
+    es1370_write_register(s, register_addr, merged_value);
+}
+
+static uint64_t es1370_read(void *opaque, hwaddr addr, unsigned size)
+{
+    const unsigned int bits_per_byte = 8;
+    ES1370State *s = opaque;
+    uint32_t register_addr = es1370_fixup(s, addr);
+    unsigned int byte_offset = register_addr & 3;
+    uint32_t register_value;
+
+    register_addr &= ~3U;
+    register_value = es1370_read_register(s, register_addr);
+
+    if (byte_offset) {
+        uint32_t shifted_value = register_value >> (byte_offset * bits_per_byte);
+
+        trace_es1370_subword_rd(register_addr, byte_offset, size, register_value, shifted_value);
+        return shifted_value;
+    }
+    return register_value;
+}
