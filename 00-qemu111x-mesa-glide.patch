+        return;
+    }
+    focus_window = SDL_GetKeyboardFocus();
+    SDL_SetRelativeMouseMode(SDL_FALSE);
+    SDL_SetWindowGrab(scon->real_window, SDL_FALSE);
+    SDL_SetWindowGrab(scon->real_window, SDL_TRUE);
