+     * A GL guest may never present at all -- the DirectDraw HAL of vmdisp9x renders
+     * into an FBO and reads the result back into guest video memory. Keep the 2D
+     * output alive for it and take the window over on its first SwapBuffers.
+     */
+    if (s->opaque)
+        wndproc_fxui_gl_takeover(s);
+    else {
+        s->gl_takeover_pending = GL_TAKEOVER_DEFERRED;
+        /* sdl_gui_restart() above may have replaced window and renderer, and a fresh
+         * renderer has no texture yet -- without one the 2D output stays black.
+         */
+        if (!s->scon->real_renderer)
+            s->scon->real_renderer = SDL_CreateRenderer(s->scon->real_window, -1, 0);
+        sdl2_2d_switch(&s->scon->dcl, s->scon->surface);
+        s->cwnd_fn(s->scon->real_window, s->hnwnd, s->opaque);
+    }
+    grab_diag("fxui_prepare: Ende");
+}
+static void wndproc_fxui_release(struct sdl_console_cb *s)
+{
+    grab_diag("fxui_release: Anfang");
+    if (s->GLon12) {
+        if (!s->scon->real_renderer)
+            s->scon->real_renderer = SDL_CreateRenderer(s->scon->real_window, -1 ,0);
+    }
+    else {
+        SDL_GL_DeleteContext(s->scon->winctx);
+        SDL_GL_ResetAttributes();
+        SDL_ResetHint(SDL_HINT_RENDER_DRIVER);
+        s->scon->winctx = NULL;
+        sdl_gui_restart(s->scon, s->icon);
+    }
+    sdl2_2d_switch(&s->scon->dcl, s->scon->surface);
+    s->render_pause = 0;
+    s->gl_takeover_pending = GL_TAKEOVER_DONE;
+    timer_del(s->ts);
+    timer_free(s->ts);
+    s->ts = NULL;
+    grab_diag("fxui_release: Ende");
