+/*
+ * The frame counter only moves when the audio backend calls us, so a guest that
+ * polls it sees a staircase instead of a ramp -- with the default timer period
+ * a step of 10 ms, with a shorter one still 2.7 ms. Real hardware advances it
+ * continuously, and a DirectSound title mixes against exactly this value: it
+ * reads the play position, works out how far ahead it may write, and glitches
+ * when the answer arrives in lumps. Quake III asks 374 times a second and gets
+ * the same answer in 62 % of them.
+ *
+ * So estimate the position at read time from the elapsed time and the sample
+ * rate. The estimate may lead the last transfer, but never by more than that
+ * transfer itself moved -- otherwise a late callback would let the guest write
+ * over data the model has not fetched yet.
+ */
+static bool es1370_position_estimate_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        const char *setting = getenv("QEMU_ES1370_POSITION_ESTIMATE");
+
+        enabled = (setting == NULL || strcmp(setting, "0") != 0);
+    }
+    return enabled != 0;
+}
+
+static uint32_t es1370_estimated_frame_cnt(ES1370State *s, struct chan *d)
+{
+    const uint32_t nanoseconds_per_second = 1000000000;
+    const uint32_t bytes_per_dword = 4;
+    size_t index = d - &s->chan[0];
+    const struct chan_bits *b = &es1370_chan_bits[index];
+    uint32_t current_dwords = d->frame_cnt >> 16;
+    uint32_t buffer_dwords = d->frame_cnt & 0xffff;
+    int64_t elapsed_ns;
+    uint64_t elapsed_bytes;
+    uint32_t elapsed_dwords;
+
+    if (!es1370_position_estimate_enabled()) {
+        return d->frame_cnt;
+    }
+    if (d->frequency == 0 || d->last_transfer_ns == 0) {
+        return d->frame_cnt;
+    }
+    if (!(s->ctl & b->ctl_en) || (s->sctl & b->sctl_pause)) {
+        return d->frame_cnt;
+    }
+
+    elapsed_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - d->last_transfer_ns;
+    if (elapsed_ns <= 0) {
+        return d->frame_cnt;
+    }
+
+    elapsed_bytes = ((uint64_t)elapsed_ns * d->frequency) / nanoseconds_per_second;
+    elapsed_bytes <<= d->shift;
+    elapsed_dwords = elapsed_bytes / bytes_per_dword;
+
+    if (elapsed_dwords > d->last_transfer_dwords) {
+        elapsed_dwords = d->last_transfer_dwords;
+    }
+    if (current_dwords + elapsed_dwords > buffer_dwords) {
+        return d->frame_cnt;
+    }
+    return buffer_dwords | ((current_dwords + elapsed_dwords) << 16);
+}
