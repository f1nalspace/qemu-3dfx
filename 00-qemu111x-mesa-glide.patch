+static void view_diag(const char *what, struct sdl2_console *scon)
+{
+    static int last_line[7];
+    int window_width = 0, window_height = 0;
+    int drawable_width = 0, drawable_height = 0;
+    int surface_w = 0, surface_h = 0;
+    int line[7];
+
+    if (!grab_diagnostics_enabled() || scon == NULL || scon->real_window == NULL) {
+        return;
+    }
+    SDL_GetWindowSize(scon->real_window, &window_width, &window_height);
+    SDL_GL_GetDrawableSize(scon->real_window, &drawable_width, &drawable_height);
+    if (scon->surface) {
+        surface_w = surface_width(scon->surface);
+        surface_h = surface_height(scon->surface);
+    }
+
+    line[0] = gui_fullscreen;
+    line[1] = surface_w;      line[2] = surface_h;
+    line[3] = window_width;   line[4] = window_height;
+    line[5] = drawable_width; line[6] = drawable_height;
+    if (!memcmp(line, last_line, sizeof(line))) {
+        return;
+    }
+    memcpy(last_line, line, sizeof(line));
+
+    fprintf(stderr, "qemu-3dfx view: %-30s vollbild=%d gast=%dx%d fenster=%dx%d flaeche=%dx%d\n",
+            what, gui_fullscreen, surface_w, surface_h,
