# Generated by the build, not part of the repo: the unpacked QEMU source tree,
# its tarball, and the build directories.
/qemu-*.tar.xz
/qemu-*.*/
/build/
wrappers/*/build/
tools/*/build/

# patch(1) leftovers
*.orig
*.rej

# Runtime files OpenGLide writes into the working directory, plus the texture
# diagnostics output. All of them are regenerated on the next run.
OpenGLid.ini
OpenGLid.log
OpenGLid.tex
OpenGLid.pal
OpenGLid-*.ppm
