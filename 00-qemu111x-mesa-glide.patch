+        view_diag(requested, &sdl2_console[0]);
+    }
+    s->scon = &sdl2_console[0];
+    s->opaque = opaque;
+    s->cwnd_fn = (void (*)(void *, void *, void *))cwnd_fn;
+    if (s->render_pause || s->gl_takeover_pending) {
