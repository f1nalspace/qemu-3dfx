+ */
+static int grab_diagnostics_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        const char *value = getenv("QEMU_3DFX_UI_DIAG");
+        if (!value) {
+            value = getenv("QEMU_3DFX_GRAB_DIAG");
+        }
