+     * do nothing with it -- and that is what a lost pointer looks like. docs/LOG.md [408].
+     */
+    if (grab_diagnostics_enabled()) {
+        fprintf(stderr, "qemu-3dfx grab: %-30s fokus=%s relativ=%d %s\n", what,
+                (focus_window == scon->real_window)? "ja":"nein", relative_result,
+                (relative_result)? SDL_GetError():"");
